# ===========================================
# Docker Environment Configuration
# ===========================================
# Copy this file to .env and update the values
# cp .env.example .env

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# ===========================================
# Email Configuration (SMTP)
# ===========================================
# For development, you can use Mailtrap (https://mailtrap.io)
# For production, use a real SMTP service (Gmail, SendGrid, AWS SES, etc.)

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your-mailtrap-username
SMTP_PASS=your-mailtrap-password
SMTP_FROM_EMAIL=noreply@swe.local
SMTP_FROM_NAME=SWE Platform

# ===========================================
# Frontend Configuration
# ===========================================
FRONTEND_URL=http://localhost:3000

# ===========================================
# Google Gemini AI Configuration
# ===========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key-here

# ===========================================
# Optional: Advanced Configuration
# ===========================================
# Uncomment and modify these if needed

# Database Configuration (override defaults)
# DATABASE_URL=mongodb://mongodb:27017/swe?retryWrites=true&w=majority&replicaSet=rs0

# Backend Port (default: 3001)
# BACKEND_PORT=3001

# Frontend Port (default: 3000)
# FRONTEND_PORT=3000

# MongoDB Port (default: 27017)
# MONGODB_PORT=27017
